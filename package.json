{
  "name": "socially-trade",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test:backend": "pnpm build && node --test apps/api/test/*.test.mjs",
    "dev:api": "pnpm --filter @socially/api dev",
    "db:migrate": "pnpm --filter @socially/db exec node --env-file-if-exists=../../.env --import tsx src/migrate.ts"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@types/ws": "^8.18.2"
    }
  }
}
