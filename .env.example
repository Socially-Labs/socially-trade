PORT=3000
DATABASE_URL=postgres://socially:socially@localhost:5432/socially_trade
REDIS_URL=redis://127.0.0.1:6379
# Service log viewer: http://localhost:3000/admin/logs
# Use the same key in API, worker and ingestor; change it for each environment.
# LOG_REDIS_KEY=socially:admin:logs:v1
# Required for remote/production log access; optional for loopback development.
# ADMIN_LOGS_TOKEN=replace-with-a-long-random-server-only-secret
# ADMIN_LOGS_ENABLED=false
NODE_ENV=development
# Server-only Jupiter credentials. Unspecified keys conservatively share "default".
# Set a stable real organisation ID, shared across replicas and key rotations.
# JUPITER_ORGANISATION_ID=your-common-organisation
# JUP_ACC_2_ORGANISATION_ID=another-organisation-only-if-verified
JUP_ACC_1=
JUP_ACC_2=
JUP_ACC_3=
JUP_ACC_4=
JUP_ACC_5=
JUP_ACC_6=
JUP_ACC_7=
JUP_ACC_8=
JUP_ACC_9=
JUP_ACC_10=
# Legacy alternative: keys from ONE organisation (do not combine with JUP_ACC_*).
# JUPITER_API_KEYS=replace-with-key-1,replace-with-key-2
# JUPITER_ORGANISATION_ID=your-stable-jupiter-organisation-id
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional separate MAINNET RPC for Jupiter Price V3 source-slot timestamps.
# Keep market mainnet data separate from DEVNET_RPC_URL wallet funding.
MARKET_RPC_URL=https://api.mainnet-beta.solana.com
# Exact browser origins permitted to open a WebSocket (required in production):
WS_ALLOWED_ORIGINS=http://localhost:3000
# Local-only manual price observations:
# DEV_PRICE_SEED_ENABLED=true
# Privy is the only authentication provider (all environments).
PRIVY_APP_ID=your-privy-app-id
# Public verification keys are fetched automatically from Privy using the app ID.
# PRIVY_APP_SECRET is not needed for access-token verification; keep any secret server-only.

# Optional exact HTTPS origins permitted for Captain avatar/banner URLs:
# CAPTAIN_ASSET_ORIGINS=https://assets.example.com

# Captain image uploads: AWS S3 + CloudFront.
AWS_REGION=ap-northeast-3
# Local credentials: aws login or an AWS_PROFILE. Production: IAM role.
# AWS_PROFILE=default
S3_ASSET_BUCKET=
S3_UPLOAD_BUCKET=
ASSET_PUBLIC_BASE_URL=
S3_UPLOAD_ORIGINS=http://localhost:3000
ASSET_STACK_NAME=socially-captain-assets-osaka
ASSET_BUCKET_PREFIX=socially-captains

# Paper trading uses database balances. Wallet funding uses SOL and Circle devnet USDC.
# DEVNET_RPC_URL=https://api.devnet.solana.com
# PRIVY_APP_SECRET= # verifies wallet ownership for swaps and live vaults

# Exact browser origins for Expo web; native mobile requests need no CORS origin.
CORS_ORIGINS=

# Round-v2 paper pilot: migrate through 027 first.
# Wallet snapshots use isolated, non-redeemable vault_paper_cash.
VAULT_PAPER_ENABLED=false
# Local development only: activate seeded paper vaults immediately for testing.
# NODE_ENV must be development; production ignores this flag.
PAPER_TEST_SKIP_FUNDRAISING=false
PAPER_WALLET_SNAPSHOT_ENABLED=false
VAULT_TERMS_APPROVAL=locked-v1-retain-residue
# Rollback pauses new capital without interrupting existing cancellations/refunds/claims.
VAULT_CONTRIBUTIONS_PAUSED=false

# Real devnet wallet swaps (independent of paper vault orders).
SWAP_ENABLED=true
# Swaps use SOLANA_RPC_URL above (DEVNET_RPC_URL is the fallback).
SWAP_VENUE_URL=https://transaction-v1-devnet.raydium.io
SWAP_SLIPPAGE_BPS=100
SWAP_MAX_PRICE_IMPACT_PCT=5
SWAP_PRIORITY_MICRO_LAMPORTS=10000
SWAP_MAX_NETWORK_FEE_LAMPORTS=1000000
SWAP_QUOTES_PER_HOUR=1800
SWAP_PREPARES_PER_HOUR=30
# PRIVY_APP_SECRET is required to verify the quoted wallet belongs to the actor.

# Real wallet-funded vaults use v1-core, never the paper ledger or treasury.
# Requires migration 026, v1-core deployed with the $100 seed floor, and config
# initialized with Circle devnet USDC (4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU).
# Creation fails closed until the program/config are ready. Exits remain available
# when this switch is false. SOL conversion reuses the bounded devnet swap policy.
LIVE_VAULTS_ENABLED=false

# Additive discovery rollout: apply migration 028 before enabling API + ingestor.
MARKET_DISCOVERY_V1_ENABLED=false

# Apply migration 029 before enabling. New policies use DYNAMIC_SPOT;
# existing paper funds require scripts/enable-dynamic-paper-markets.mjs <ids>.
# false pauses new dynamic buys; held assets still track and can sell.
PAPER_DYNAMIC_MARKETS_ENABLED=false
PAPER_PRIVATE_UPDATES_ENABLED=false
# Birdeye mint/USD OHLCV. Enable only after verifying plan, coverage and caching rights.
# No API key means CREDENTIAL_MISSING; stored charts remain available.
MARKET_HISTORY_PROVIDER_ENABLED=false
BIRDEYE_API_KEY=
# Conservative history-only allowance; 100 CU reserved per fetch, maximum 30000.
BIRDEYE_HISTORY_MONTHLY_CU_BUDGET=25000

# Token logos use shared Redis caching and the existing S3_ASSET_BUCKET when set.
# HTTPS gateway prefixes ending in /ipfs/. No extra Jupiter calls are made.
TOKEN_ICON_IPFS_GATEWAYS=https://ipfs.filebase.io/ipfs/,https://gateway.pinata.cloud/ipfs/

# Shared paper execution policy. Set identically on API, worker and ingestor.
PAPER_PRICE_MAX_AGE_MS=15000
PAPER_PRICE_FUTURE_SKEW_MS=5000
PAPER_ORDER_DELAY_MS=3000
PAPER_ORDER_TIMEOUT_MS=120000
PAPER_MAX_ORDER_USDC=1000
PAPER_TRACKED_ASSET_LIMIT=100
PAPER_SPREAD_BPS=20
PAPER_FEE_BPS=10
PAPER_IMPACT_BPS_PER_THOUSAND=1
PAPER_MAX_IMPACT_BPS=50
PAPER_UNWIND_COST_BPS=20

# Database budgets (milliseconds), including financial locks and stream scans.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Completed-cycle readiness, distinct from GET /live process liveness.
PAPER_HEARTBEAT_INTERVAL_MS=10000
PAPER_HEARTBEAT_MAX_AGE_MS=60000
PAPER_RECONCILIATION_BATCH_SIZE=20
PAPER_RECONCILIATION_INTERVAL_MS=300000

# Expiring Redis leases enforce these limits across API replicas.
PAPER_CONNECTION_LEASE_MS=60000
PAPER_WS_HEARTBEAT_MS=20000
PAPER_SSE_MAX_CONNECTIONS=200
PAPER_SSE_MAX_PER_IP=10
PAPER_SSE_MAX_PER_USER=5
PAPER_SSE_MAX_BUFFER_BYTES=262144
PAPER_MARKET_WS_MAX_CONNECTIONS=1000
PAPER_MARKET_WS_MAX_PER_IP=10
PAPER_MARKET_WS_MAX_PER_USER=5
PAPER_VAULT_WS_MAX_CONNECTIONS=200
PAPER_VAULT_WS_MAX_PER_IP=10
PAPER_VAULT_WS_MAX_PER_USER=5

# Durable notifications: enable after migration 038 and device credential setup.
NOTIFICATION_PUSH_ENABLED=false
# Expo enhanced push security access token (server only).
EXPO_ACCESS_TOKEN=
# Finalized external SOL/USDC receipt observer. Devnet only, genesis checked.
WALLET_NOTIFICATIONS_ENABLED=false

# Optional RPC provider WebSocket endpoint; otherwise derived from SOLANA_RPC_URL.
SOLANA_WS_URL=
