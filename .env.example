PORT=3000
DATABASE_URL=postgres://socially:socially@localhost:5432/socially_trade
NODE_ENV=development
DEV_AUTH_TOKEN=replace-with-a-long-random-local-secret
PYTH_API_KEY=replace-with-pyth-api-key
# Local-only manual price observations:
# DEV_PRICE_SEED_ENABLED=true
# For production JWT verification:
# AUTH_JWKS_URL=https://your-identity-provider/.well-known/jwks.json
# AUTH_ISSUER=https://your-identity-provider/
# AUTH_AUDIENCE=socially-trade-api
# Privy access-token verification (production alternative to generic JWT):
# AUTH_PROVIDER=privy
# PRIVY_APP_ID=your-privy-app-id
# PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Use the public ES256 verification key from your Privy dashboard, not the app secret.
