PORT=3000
DATABASE_URL=postgres://socially:socially@localhost:5432/socially_trade
REDIS_URL=redis://127.0.0.1:6379
NODE_ENV=development
JUPITER_API_KEYS=replace-with-jupiter-key-1,replace-with-jupiter-key-2
JUPITER_ORGANISATION_ID=your-jupiter-organisation-id
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Exact browser origins permitted to open a WebSocket (required in production):
WS_ALLOWED_ORIGINS=http://localhost:3000
# Local-only manual price observations:
# DEV_PRICE_SEED_ENABLED=true
# Privy is the only authentication provider (all environments).
PRIVY_APP_ID=your-privy-app-id
# Public verification keys are fetched automatically from Privy using the app ID.
# PRIVY_APP_SECRET is not needed for access-token verification; keep any secret server-only.

# Optional exact HTTPS origins permitted for Captain avatar/banner URLs:
# CAPTAIN_ASSET_ORIGINS=https://assets.example.com

# Captain image uploads: Cloudflare R2, two dedicated buckets.
CLOUDFLARE_ACCOUNT_ID=
# Setup-only token with R2 bucket management permissions:
CLOUDFLARE_API_TOKEN=
# Runtime S3 credentials with object read/write access to both buckets:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=socially-captain-assets
R2_UPLOAD_BUCKET=socially-captain-uploads
# Written by assets:setup; HTTPS custom domain in production:
R2_PUBLIC_BASE_URL=
R2_UPLOAD_ORIGINS=http://localhost:3000
# Optional development; required in production:
# R2_CUSTOM_DOMAIN=assets.example.com
# CLOUDFLARE_ZONE_ID=
