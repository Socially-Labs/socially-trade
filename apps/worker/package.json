{
  "name": "@socially/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "price:once": "tsx src/price-once.ts",
    "price:seed": "tsx src/seed-price.ts"
  },
  "dependencies": {
    "@socially/db": "workspace:*",
    "@socially/market-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
