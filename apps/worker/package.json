{
  "name": "@socially/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "price:seed": "tsx src/seed-price.ts",
    "orders:once": "tsx src/orders-once.ts",
    "notifications:once": "tsx src/notifications-once.ts"
  },
  "dependencies": {
    "@socially/db": "workspace:*",
    "@socially/domain": "workspace:*",
    "@socially/market-data": "workspace:*",
    "@socially/logging": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
