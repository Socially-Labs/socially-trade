{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL", "REDIS_URL", "SOLANA_*", "JUP_ACC_*", "JUPITER_*",
        "PRIVY_*", "AWS_*", "S3_*", "ASSET_*", "USDG_*", "TOKEN_*",
        "DEPOSIT_*", "PAYOUT_*", "WITHDRAW_*", "QR_*", "ADMIN_LOGS_*", "LOG_*",
        "CORS_ORIGINS", "WS_ALLOWED_ORIGINS", "HOST", "PORT", "NODE_ENV", "DEV_PRICE_SEED_ENABLED"
      ]
    }
  }
}
