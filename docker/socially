#!/bin/sh
# dist/index.js and ../../.env are resolved from the package directory.
# migrate finds SQL from dist/migrate.js via import.meta.url, not from cwd.
# exec so the role is pid 1 and receives SIGTERM.
set -eu
role=${1:?usage: socially api|worker|ingestor|migrate}
export NODE_ENV=production

case "$role" in
  api|worker|ingestor)
    if [ "$role" = "api" ] && [ -z "${SWAP_ENABLED:-}" ]; then
      echo "SWAP_ENABLED is unset. Set false unless this API is on Solana devnet. The app default is true and calls devnet genesis before listen." >&2
      exit 64
    fi
    if [ "$role" = "api" ]; then
      # Coolify's compose up -d does not print a one-shot container's stderr.
      # Migrate in this process so a failure stays in the API logs.
      cd /app/packages/db
      node --input-type=module -e 'const raw=process.env.DATABASE_URL??""; try { console.error("migrate database host: "+(raw?new URL(raw).host:"missing")) } catch { console.error("migrate database host: invalid") }'
      node --env-file-if-exists=../../.env dist/migrate.js
    fi
    cd "/app/apps/$role"
    exec node --env-file-if-exists=../../.env dist/index.js
    ;;
  migrate)
    cd /app/packages/db
    exec node --env-file-if-exists=../../.env dist/migrate.js
    ;;
  *)
    echo "unknown role: $role" >&2
    exit 64
    ;;
esac
