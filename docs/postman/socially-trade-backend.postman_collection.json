{
  "info": {
    "name": "socially.trade backend (v0 paper)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Endpoints exercised in the 2026-10-05 functional check. Set baseUrl, privyToken (Captain) and crewToken (Crew) to Privy access tokens for PRIVY_APP_ID. All amounts are decimal strings. All values are virtual (PAPER). The Devnet token layer folder needs USDG_MINT: deposits and withdrawals move the USDG (devnet) test token."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{privyToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "privyToken",
      "value": ""
    },
    {
      "key": "crewToken",
      "value": ""
    },
    {
      "key": "captainId",
      "value": ""
    },
    {
      "key": "fundId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": "1"
    },
    {
      "key": "walletAddress",
      "value": ""
    },
    {
      "key": "depositSignature",
      "value": ""
    },
    {
      "key": "withdrawalId",
      "value": ""
    }
  ],
