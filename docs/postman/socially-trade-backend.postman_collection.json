    {
      "name": "Devnet token layer",
      "description": "Requires USDG_MINT and the token layer env vars. Only money in and out touches Solana devnet; trading stays paper.",
      "item": [
        {
          "name": "Bootstrap with a Solana wallet (token layer)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v0/auth/privy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "auth",
                "privy"
              ]
            },
            "description": "With USDG_MINT set: binds the Solana wallet once and mints the signup grant (SIGNUP_GRANT, default 10,000 USDG devnet) to its token account, once per user. With PRIVY_APP_SECRET the backend takes the wallet from the Privy user record and walletAddress is optional (it must be a linked wallet). Without the secret the bind fails closed with 503 wallet_verification_unconfigured, unless the server runs with DEV_ALLOW_UNVERIFIED_WALLET=1 (localhost or devnet RPC only), which accepts walletAddress as sent. A user from before the token layer converts its current paper cash instead: the grant equals that cash and paper cash becomes 0. Paper cash starts at 0.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletAddress\": \"{{walletAddress}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Token balance",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v0/me/token-balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "token-balance"
              ]
            },
            "description": "On-chain USDG (devnet) balance of the bound wallet plus paper cash and fund positions. Also reconciles pending payouts."
          }
        },
        {
          "name": "Prepare deposit transaction",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v0/me/deposits/prepare",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "deposits",
                "prepare"
              ]
            },
            "description": "Returns a base64 v0 transaction: TransferChecked of amountUsdc from the user's token account to the treasury token account. The treasury already signed as fee payer, so the user needs no SOL. The wallet signs and sends it, then posts the signature. Rate limited per user (PREPARE_RATE_PER_HOUR, default 20): 429 rate_limited.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountUsdc\": \"100.000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Submit deposit signature",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v0/me/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "deposits"
              ]
            },
            "description": "Credits paper cash after the backend fetches the transaction from devnet and checks: finalized, success, exactly one top-level transferChecked and no inner instructions, our mint, exact amount, source owner and authority = bound wallet, destination = treasury. 202 PENDING if devnet does not have it yet; then poll the status request. CONFIRMED and FAILED are terminal. EXPIRED needs the signature missing on chain past its block height bound and DEPOSIT_EXPIRY_SECONDS; a later status poll that finds the transaction finalized still credits it once.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signature\": \"{{depositSignature}}\",\n  \"amountUsdc\": \"100.000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Submit deposit signature and join fund",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v0/me/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "deposits"
              ]
            },
            "description": "Same checks, then joins the fund with the same amount in the same database transaction. If the join is refused, the credit stays as paper cash and deposit.join.error names the reason.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signature\": \"{{depositSignature}}\",\n  \"amountUsdc\": \"100.000000\",\n  \"fundId\": \"{{fundId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Deposit status",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v0/me/deposits/{{depositSignature}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "deposits",
                "{{depositSignature}}"
              ]
            },
            "description": "Re-verifies a PENDING or EXPIRED deposit; returns the stored state otherwise."
          }
        },
        {
          "name": "Withdraw paper cash",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "withdraw-{{$guid}}",
                "description": "Reuse the same value when you retry the same withdrawal."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v0/me/withdrawals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "withdrawals"
              ]
            },
            "description": "Debits paper cash and sends the same amount of USDG (devnet) from the treasury to the wallet. One send per Idempotency-Key. 201 CONFIRMED or 202 PENDING. Minimum WITHDRAW_MIN (default 1 token, else 400 amount_too_small); at most WITHDRAW_RATE_PER_HOUR (default 10) per user (429 rate_limited). The treasury pays for the user's token account at most 3 times; after that, a wallet without the account gets 409 token_account_required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountUsdc\": \"50.000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set('withdrawalId', pm.response.json().withdrawal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Exit fund and withdraw",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "exit-withdraw-{{$guid}}",
                "description": "Reuse the same value when you retry the same withdrawal."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v0/me/withdrawals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "withdrawals"
              ]
            },
            "description": "Burns shares (paper exit) and withdraws the exit payout on chain in one request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fundId\": \"{{fundId}}\",\n  \"shares\": \"10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set('withdrawalId', pm.response.json().withdrawal.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdrawal status",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{crewToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v0/me/withdrawals/{{withdrawalId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v0",
                "me",
                "withdrawals",
                "{{withdrawalId}}"
              ]
            },
            "description": "Reconciles the payout with devnet (rebroadcast, or re-sign only after the old blockhash expired) and returns its state."
          }
        }
      ]
    }
  ]
}
